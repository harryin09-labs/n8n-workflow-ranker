# n8n Workflow Intelligence & Ranking System Environment Configuration

# AI Provider Configuration (OpenAI Compatible)
AI_PROVIDER=openai_compatible
AI_BASE_URL=http://127.0.0.1:20128/v1
AI_MODEL=auto
AI_API_KEY=

# Set to true to enable LLM-assisted analysis (optional, deterministic scoring works without this)
ENABLE_AI_SCORING=false

# Database Configuration
DATABASE_PATH=data/n8n_workflows.db

# Crawling and Concurrency
CRAWLER_CONCURRENCY=5
CRAWLER_DELAY_SECONDS=0.5
CRAWLER_TIMEOUT_SECONDS=15
CRAWLER_USER_AGENT=n8n-Workflow-Ranker/1.0 (+https://github.com/n8n-ranker)

# Log Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
